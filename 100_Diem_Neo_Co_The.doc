    <tr><td align='center'>67</td><td>Nếp gấp khuỷu</td><td>Rãnh nếp gấp mặt trước tay</td></tr>
    <tr><td align='center'>68</td><td>Cẳng tay ngoài</td><td>Mặt nhiều lông, hướng ra ngoài</td></tr>
    <tr><td align='center'>69</td><td>Cẳng tay trong</td><td>Mặt nhẵn mịn, áp sát vào hông</td></tr>
    <tr><td align='center'>70</td><td>Cổ tay</td><td>Các nếp gấp chia ranh giới cẳng - bàn tay</td></tr>
</table>

<h2>🤚 TRẠM 8: BÀN TAY (Từ mặt sau ra mặt trước)</h2>
<table>
    <tr><th width='10%'>STT</th><th width='35%'>Điểm neo</th><th>Hình dung vị trí</th></tr>
