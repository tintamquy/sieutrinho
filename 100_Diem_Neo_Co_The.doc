    <tr><td align='center'>78</td><td>Đầu ngón giữa</td><td>Đệm thịt ngón số 3</td></tr>
    <tr><td align='center'>79</td><td>Đầu ngón áp út</td><td>Đệm thịt ngón số 4 (ngón đeo nhẫn)</td></tr>
    <tr><td align='center'>80</td><td>Đầu ngón út</td><td>Đệm thịt ngón số 5</td></tr>
</table>

<h2>🦵 TRẠM 9: ĐÙI, GỐI & CẲNG CHÂN (Mặt sau rồi mặt trước)</h2>
<table>
    <tr><th width='10%'>STT</th><th width='35%'>Điểm neo</th><th>Hình dung vị trí</th></tr>
